# ── Email sending ──────────────────────────────────────────────────────────
# If your company email is on GOOGLE WORKSPACE (opens in Gmail):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=pabloacosta@eliteconsultingpartners.com
#   SMTP_PASS=  ← App Password from myaccount.google.com → Security → App Passwords
#
# If your company email is on MICROSOFT 365 / OUTLOOK:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USER=pabloacosta@eliteconsultingpartners.com
#   SMTP_PASS=  ← your regular Outlook password (or App Password if MFA is on)
# ──────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pabloacosta@eliteconsultingpartners.com
SMTP_PASS=your-app-password-here

